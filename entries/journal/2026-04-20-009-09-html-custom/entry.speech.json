{"version":1,"segments":[{"id":"01KPMM1Z1PMECHVYKYKWE2XPDV:s0:1776664261248","type":"block","blockId":"01KPMM1Z1PMECHVYKYKWE2XPDV","text":"Escape hatches","narrator":"","audioHash":null},{"id":"01KPMM1Z1PKFQVSAZDW3G0KYBC:s0:1776664261248","type":"block","blockId":"01KPMM1Z1PKFQVSAZDW3G0KYBC","text":"Raw HTML","narrator":"","audioHash":null},{"id":"01KPMM1Z1P9P6G79FFFQR7SD6D:s0:1776664261248","type":"block","blockId":"01KPMM1Z1P9P6G79FFFQR7SD6D","text":"For the rare case where markdown can't express what you need.","narrator":"","audioHash":null},{"id":"01KPMM1Z1P9P6G79FFFQR7SD6D:s1:1776664261249","type":"block","blockId":"01KPMM1Z1P9P6G79FFFQR7SD6D","text":"The renderer passes the block through verbatim — there's no sandboxing, so use it only for your own markup.","narrator":"","audioHash":null},{"id":"01KPMM1Z1PXE2RX64CEJ5N5796:s0:1776664261248","type":"block","blockId":"01KPMM1Z1PXE2RX64CEJ5N5796","text":"Custom directive","narrator":"","audioHash":null},{"id":"01KPMM1Z1PDYAWY8J5GE32MVP3:s0:1776664261248","type":"block","blockId":"01KPMM1Z1PDYAWY8J5GE32MVP3","text":"Directives the renderer doesn't have a handler for fall through to a raw YAML block.","narrator":"","audioHash":null},{"id":"01KPMM1Z1PDYAWY8J5GE32MVP3:s1:1776664261249","type":"block","blockId":"01KPMM1Z1PDYAWY8J5GE32MVP3","text":"Useful for plugins that haven't been installed on the reader's side — the content still parses, it just doesn't bind to a component.","narrator":"","audioHash":null},{"id":"01KPMM1Z1P68JZP9KGDWCQ6RYT:s0:1776664261248","type":"block","blockId":"01KPMM1Z1P68JZP9KGDWCQ6RYT","text":"When a plugin for that namespace:name ships later, the same content renders without edits.","narrator":"","audioHash":null}]}