{"version":1,"segments":[{"id":"01KPMRMZY9M13PFX6A24K2GJXT:s0:1776666013431","type":"block","blockId":"01KPMRMZY9M13PFX6A24K2GJXT","text":"Escape hatches","narrator":"","audioHash":null},{"id":"01KPMRMZY97XHV0NBMM501NZN6:s0:1776666013431","type":"block","blockId":"01KPMRMZY97XHV0NBMM501NZN6","text":"Raw HTML","narrator":"","audioHash":null},{"id":"01KPMRMZY9YHE2PAF74CGVJ1N4:s0:1776666013431","type":"block","blockId":"01KPMRMZY9YHE2PAF74CGVJ1N4","text":"For the rare case where markdown can't express what you need.","narrator":"","audioHash":null},{"id":"01KPMRMZY9YHE2PAF74CGVJ1N4:s1:1776666013432","type":"block","blockId":"01KPMRMZY9YHE2PAF74CGVJ1N4","text":"The renderer passes the block through verbatim — there's no sandboxing, so use it only for your own markup.","narrator":"","audioHash":null},{"id":"01KPMRMZY9S4ZVFW7R054ZDGMZ:s0:1776666013431","type":"block","blockId":"01KPMRMZY9S4ZVFW7R054ZDGMZ","text":"Custom directive","narrator":"","audioHash":null},{"id":"01KPMRMZY9C2E557J5KYZY9V5A:s0:1776666013431","type":"block","blockId":"01KPMRMZY9C2E557J5KYZY9V5A","text":"Directives the renderer doesn't have a handler for fall through to a raw YAML block.","narrator":"","audioHash":null},{"id":"01KPMRMZY9C2E557J5KYZY9V5A:s1:1776666013432","type":"block","blockId":"01KPMRMZY9C2E557J5KYZY9V5A","text":"Useful for plugins that haven't been installed on the reader's side — the content still parses, it just doesn't bind to a component.","narrator":"","audioHash":null},{"id":"01KPMRMZY9PDX9BMKA37XDW4NJ:s0:1776666013431","type":"block","blockId":"01KPMRMZY9PDX9BMKA37XDW4NJ","text":"When a plugin for that namespace:name ships later, the same content renders without edits.","narrator":"","audioHash":null}]}