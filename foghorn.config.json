{
  "version": 1,
  "site": {
    "title": "My Foghorn Blog",
    "description": "A Foghorn-powered accessible blog.",
    "baseUrl": "https://example.com",
    "theme": "default"
  },
  "deployment": {
    "target": "github-pages",
    "config": {}
  },
  "routes": [
    {
      "id": "journal",
      "title": "Journal",
      "path": "/entry/:slug",
      "contentDir": "entries/journal",
      "layout": "src/layouts/JournalEntry.astro",
      "rss": {
        "feed": "/feed.xml",
        "guidFrom": "entry"
      }
    }
  ],
  "authors": [
    {
      "id": "stoney",
      "name": "Stoney Eagle",
      "avatar": "/authors/stoney.jpg",
      "gitEmail": "patrickstaarink@hotmail.com",
      "bio": "",
      "agent": false
    }
  ],
  "share": {
    "platforms": [
      "bluesky",
      "mastodon",
      "copy-link",
      "rss"
    ],
    "mastodonInstance": "https://hachyderm.io",
    "showShareCounts": false,
    "position": "end"
  },
  "defaultLicense": "CC-BY-SA-4.0",
  "codeLicense": "MIT",
  "tts": {
    "default": "edge-tts",
    "providers": {
      "edge-tts": {
        "enabled": true
      }
    },
    "voices": {
      "aria": {
        "provider": "edge-tts",
        "voiceId": "en-US-AriaNeural",
        "styles": []
      }
    }
  },
  "ai": {
    "default": "none",
    "providers": {},
    "agents": []
  },
  "plugins": [],
  "updates": {
    "channel": "stable",
    "autoDownload": false
  },
  "design": {}
}